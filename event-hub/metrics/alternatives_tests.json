{
    "explicitSelector": {
        "name": "Alternative: explicit experiment names and prefixes",
        "desc": "Specifies the alternative to full-match regular expressions, using config_explicit_reference.json. Included so the trade-off argued in the technical design is testable rather than asserted. The notable result is that a prefix over-matches where the equivalent full-match pattern does not, which is why the recommendation is the regular expression.",
        "configReference": "config_explicit_reference.json",
        "tests": [
            {
                "name": "An exact name list selects only the listed experiments",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 },
                    { "experiment": "contentScopeExperiment10", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "exactMatchEvent", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "exactMatch", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "A prefix over-matches longer names sharing that prefix",
                "desc": "The prefix contentScopeExperiment1 also selects contentScopeExperiment10. The full-match regular expression contentScopeExperiment1 does not, which is the substance of the safety comparison.",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 },
                    { "experiment": "contentScopeExperiment10", "cohort": "control", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "prefixMatchEvent", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "prefixMatch", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" },
                    { "metric": "prefixMatch", "experiment": "contentScopeExperiment10", "cohort": "control", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "The wildcard sentinel selects every enrolled experiment regardless of parent feature",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 2 },
                    { "experiment": "tdsNextExperiment007", "cohort": "control", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 2 }
                ],
                "events": [
                    { "type": "pageLoaded", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "pageLoad", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-5", "value": "1" },
                    { "metric": "pageLoad", "experiment": "tdsNextExperiment007", "cohort": "control", "conversionWindowDays": "0-5", "value": "1" }
                ]
            },
            {
                "name": "A literal asterisk is only a wildcard as the sole entry, not inside a name",
                "desc": "Records the ambiguity that the sentinel introduces and which the regular expression form does not have.",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "exactMatchEvent", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "exactMatch", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            }
        ]
    },
    "tabDeduplicatedStream": {
        "name": "Alternative: tab-scoped de-duplication of the event stream",
        "desc": "Specifies the alternative de-duplication semantic under discussion, in which metrics reuse the aggregate counter behaviour: at most one occurrence per metric, per source, per tab, reset on navigation to a different URL. Same inputs as the eventStream set in tests.json, different expectations. Only one of these two sets should be adopted.",
        "configReference": "config_reference.json",
        "tests": [
            {
                "name": "Repeated occurrences within one page in one tab count once",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/page" },
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/page" },
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/page" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "Navigating to a different URL permits a further occurrence",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/one" },
                    { "type": "navigation", "tabId": "tab-1", "url": "https://example.com/two" },
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/two" },
                    { "type": "navigation", "tabId": "tab-1", "url": "https://example.com/three" },
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/three" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" },
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "3" }
                ]
            },
            {
                "name": "Occurrences in separate tabs each count",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/" },
                    { "type": "captchaDetected", "tabId": "tab-2", "url": "https://example.com/" },
                    { "type": "captchaDetected", "tabId": "tab-3", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" },
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "3" }
                ]
            },
            {
                "name": "A native event with no tab is never de-duplicated",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "appLaunch" },
                    { "type": "appLaunch" }
                ],
                "expectConversions": [
                    { "metric": "appLaunched", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            }
        ]
    }
}
