{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Experiment metrics lifecycle reference tests",
    "type": "object",
    "properties": {
        "$schema": { "type": "string" }
    },
    "additionalProperties": { "$ref": "#/definitions/testSet" },
    "definitions": {
        "testSet": {
            "type": "object",
            "required": ["name", "desc", "configReference", "tests"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "desc": { "type": "string" },
                "configReference": { "type": "string" },
                "tests": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/definitions/test" }
                }
            }
        },
        "test": {
            "type": "object",
            "required": ["name", "exceptPlatforms", "phases", "expectConversions"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "desc": { "type": "string" },
                "exceptPlatforms": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "phases": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/definitions/phase" }
                },
                "expectConversions": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/conversion" }
                }
            }
        },
        "phase": {
            "type": "object",
            "required": ["events"],
            "additionalProperties": false,
            "properties": {
                "activeExperiments": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/activeExperiment" }
                },
                "experimentMetrics": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": { "type": "string" }
                    }
                },
                "experimentStates": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string",
                        "enum": ["enabled", "disabled"]
                    }
                },
                "featureStates": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string",
                        "enum": ["enabled", "disabled"]
                    }
                },
                "events": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event" }
                }
            }
        },
        "activeExperiment": {
            "type": "object",
            "required": ["experiment", "cohort", "enrollmentDate"],
            "additionalProperties": false,
            "properties": {
                "experiment": { "type": "string" },
                "cohort": { "type": "string" },
                "enrollmentDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
        },
        "event": {
            "type": "object",
            "required": ["type", "day"],
            "additionalProperties": false,
            "properties": {
                "type": { "type": "string" },
                "tabId": { "type": "string" },
                "url": { "type": "string" },
                "day": { "type": "integer", "minimum": 0 }
            }
        },
        "conversion": {
            "type": "object",
            "required": ["metric", "experiment", "cohort", "conversionWindowDays", "value"],
            "additionalProperties": false,
            "properties": {
                "metric": { "type": "string" },
                "experiment": { "type": "string" },
                "cohort": { "type": "string" },
                "conversionWindowDays": { "type": "string", "pattern": "^\\d+(-\\d+)?$" },
                "value": { "type": "string", "pattern": "^\\d+$" },
                "enrollmentDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
        }
    }
}
