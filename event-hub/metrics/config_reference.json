{
    "readme": "Reference configuration for remotely-configured event-driven metrics. Each key under metrics is a metric name; each value is a list of entries. Windows and thresholds form a product within an entry, so searchLike demonstrates the partial product that production retention metrics use: threshold 1 over per-day windows in one entry, higher thresholds over range windows in another. There is no state field: presence means the metric converts. Experiment cohort weights are irrelevant here, because tests declare enrolled experiments directly via activeExperiments; cohort assignment and enrollment are owned by each experiment type and are out of scope.",
    "features": {
        "webEvents": {
            "state": "enabled",
            "exceptions": []
        },
        "eventHub": {
            "state": "enabled",
            "exceptions": [],
            "settings": {
                "metrics": {
                    "reloadLoop": [
                        {
                            "source": "reloadLoopDetected",
                            "windows": [
                                [0, 0],
                                [0, 7]
                            ],
                            "thresholds": [1],
                            "experiments": ["contentScopeExperiment3"]
                        }
                    ],
                    "captchaSeen": [
                        {
                            "source": "captchaDetected",
                            "windows": [
                                [0, 7]
                            ],
                            "thresholds": [1, 3],
                            "experiments": ["contentScopeExperiment.*"]
                        }
                    ],
                    "searchLike": [
                        {
                            "source": "searchPerformed",
                            "windows": [
                                [0, 0],
                                [1, 1]
                            ],
                            "thresholds": [1],
                            "experiments": ["contentScopeExperiment1"]
                        },
                        {
                            "source": "searchPerformed",
                            "windows": [
                                [0, 7]
                            ],
                            "thresholds": [2, 3],
                            "experiments": ["contentScopeExperiment1"]
                        }
                    ],
                    "exactMatch": [
                        {
                            "source": "exactMatchEvent",
                            "windows": [
                                [0, 7]
                            ],
                            "thresholds": [1],
                            "experiments": ["contentScopeExperiment1"]
                        }
                    ],
                    "blocklistFailure": [
                        {
                            "source": "tdsDownloadFailed",
                            "windows": [
                                [0, 7]
                            ],
                            "thresholds": [1],
                            "experiments": ["tdsNextExperiment.*"]
                        }
                    ],
                    "pageLoad": [
                        {
                            "source": "pageLoaded",
                            "windows": [
                                [0, 5]
                            ],
                            "thresholds": [1],
                            "experiments": [".*"]
                        }
                    ],
                    "appLaunched": [
                        {
                            "source": "appLaunch",
                            "windows": [
                                [0, 7]
                            ],
                            "thresholds": [1],
                            "experiments": [".*"]
                        }
                    ],
                    "unenrolled": [
                        {
                            "source": "reloadLoopDetected",
                            "windows": [
                                [0, 7]
                            ],
                            "thresholds": [1],
                            "experiments": ["contentScopeExperiment19"]
                        }
                    ],
                    "defaultThreshold": [
                        {
                            "source": "defaultThresholdEvent",
                            "windows": [
                                [0, 7]
                            ],
                            "experiments": ["contentScopeExperiment1"]
                        }
                    ]
                }
            }
        },
        "contentScopeExperiments": {
            "state": "enabled",
            "exceptions": [],
            "features": {
                "contentScopeExperiment1": {
                    "state": "enabled",
                    "cohorts": [
                        { "name": "control", "weight": 1 },
                        { "name": "treatment", "weight": 1 }
                    ]
                },
                "contentScopeExperiment3": {
                    "state": "enabled",
                    "cohorts": [
                        { "name": "control", "weight": 1 },
                        { "name": "treatment", "weight": 1 }
                    ]
                },
                "contentScopeExperiment10": {
                    "state": "enabled",
                    "cohorts": [
                        { "name": "control", "weight": 1 },
                        { "name": "treatment", "weight": 1 }
                    ]
                },
                "contentScopeExperiment19": {
                    "state": "enabled",
                    "cohorts": [
                        { "name": "control", "weight": 1 },
                        { "name": "treatment", "weight": 1 }
                    ]
                }
            }
        },
        "contentBlocking": {
            "state": "enabled",
            "exceptions": [],
            "features": {
                "tdsNextExperiment007": {
                    "state": "enabled",
                    "cohorts": [
                        { "name": "control", "weight": 1 },
                        { "name": "treatment", "weight": 1 }
                    ]
                }
            }
        }
    },
    "unprotectedTemporary": []
}
