                        "windows": [
                            [0, 7]
                        ],
                        "value": 1,
                        "experiments": ["contentScopeExperiment1", "contentScopeExperiment3"]
                    },
                    "prefixMatched": {
                        "state": "enabled",
                        "name": "prefixMatch",
                        "source": "prefixMatchEvent",
