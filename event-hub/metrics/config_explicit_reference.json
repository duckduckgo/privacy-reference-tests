                            [0, 7]
                        ],
                        "value": 1,
                        "experimentPrefixes": ["contentScopeExperiment1"]
                    },
                    "allExperiments": {
                        "state": "enabled",
                        "name": "pageLoad",
                        "source": "pageLoaded",
                        "windows": [
                            [0, 5]
                        ],
                        "value": 1,
                        "experiments": ["*"]
                    }
                }
            }
        },
        "contentScopeExperiments": {
