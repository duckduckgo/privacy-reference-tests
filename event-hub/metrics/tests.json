{
    "selection": {
        "name": "Selecting target experiments for a metric",
        "desc": "A metric converts against every experiment the user is already enrolled in whose name is a full match for one of the metric's patterns. Selection ignores the parent feature: a pattern may match content scope experiments, TDS experiments or anything else. Enrollment itself is owned by each experiment type and is not exercised here.",
        "configReference": "config_reference.json",
        "tests": [
            {
                "name": "A pattern without metacharacters is a full match, not a prefix",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 },
                    { "experiment": "contentScopeExperiment10", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "exactMatchEvent", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "exactMatch", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "A trailing wildcard matches every experiment sharing the prefix",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "control", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 },
                    { "experiment": "contentScopeExperiment10", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "control", "conversionWindowDays": "0-7", "value": "1" },
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment10", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "A pattern matches experiments regardless of their parent feature",
                "desc": "pageLoad selects with '.*'. contentScopeExperiment1 sits under contentScopeExperiments and tdsNextExperiment007 under contentBlocking; both are selected.",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 2 },
                    { "experiment": "tdsNextExperiment007", "cohort": "control", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 2 }
                ],
                "events": [
                    { "type": "pageLoaded", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "pageLoad", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-5", "value": "1" },
                    { "metric": "pageLoad", "experiment": "tdsNextExperiment007", "cohort": "control", "conversionWindowDays": "0-5", "value": "1" }
                ]
            },
            {
                "name": "A metric selecting only TDS experiments does not convert for a content scope experiment",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "tdsDownloadFailed", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": []
            },
            {
                "name": "A metric selecting an experiment the user is not enrolled in does not convert",
                "desc": "unenrolledTarget selects contentScopeExperiment19 and shares the reloadLoopDetected source with reloadLoopFirst. Only the enrolled experiment converts.",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment3", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "reloadLoopDetected", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "reloadLoop", "experiment": "contentScopeExperiment3", "cohort": "treatment", "conversionWindowDays": "0", "value": "1" },
                    { "metric": "reloadLoop", "experiment": "contentScopeExperiment3", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "A disabled metric never converts",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "retiredEvent", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": []
            },
            {
                "name": "An event matching no metric source is ignored",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "someUnrelatedEvent", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": []
            },
            {
                "name": "A native event with no associated tab converts",
                "desc": "Metrics must work for any event, not only web events from content scope scripts. A native event carries no tabId or url.",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "appLaunch" }
                ],
                "expectConversions": [
                    { "metric": "appLaunched", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            }
        ]
    },
    "conversionWindows": {
        "name": "Conversion window evaluation",
        "desc": "Windows are inclusive at both ends and measured in whole days from the enrollment day, which is day 0. A metric with several windows reports one conversion per window that contains the current day, independently. Tests use whole-day offsets away from midnight because platforms differ in how they count a day.",
        "configReference": "config_reference.json",
        "tests": [
            {
                "name": "On the enrollment day both the single-day and the range window convert",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment3", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "reloadLoopDetected", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "reloadLoop", "experiment": "contentScopeExperiment3", "cohort": "treatment", "conversionWindowDays": "0", "value": "1" },
                    { "metric": "reloadLoop", "experiment": "contentScopeExperiment3", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "On day 1 only the range window converts",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment3", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "reloadLoopDetected", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "reloadLoop", "experiment": "contentScopeExperiment3", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "The upper bound of a window is inclusive",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment3", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 7 }
                ],
                "events": [
                    { "type": "reloadLoopDetected", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "reloadLoop", "experiment": "contentScopeExperiment3", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "The day after the upper bound does not convert",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment3", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 8 }
                ],
                "events": [
                    { "type": "reloadLoopDetected", "tabId": "tab-1", "url": "https://example.com/" }
                ],
                "expectConversions": []
            },
            {
                "name": "A metric converts at most once per window per experiment",
                "desc": "Two occurrences on the same day yield the same conversions as one, because each window has already converted.",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment3", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 0 }
                ],
                "events": [
                    { "type": "reloadLoopDetected", "tabId": "tab-1", "url": "https://example.com/" },
                    { "type": "reloadLoopDetected", "tabId": "tab-2", "url": "https://other.example/" }
                ],
                "expectConversions": [
                    { "metric": "reloadLoop", "experiment": "contentScopeExperiment3", "cohort": "treatment", "conversionWindowDays": "0", "value": "1" },
                    { "metric": "reloadLoop", "experiment": "contentScopeExperiment3", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            }
        ]
    },
    "thresholds": {
        "name": "Value thresholds and cumulative histograms",
        "desc": "A metric with value N converts when its source event is seen for the Nth time inside the window. Two metric entries sharing a name with different values form a cumulative histogram: each threshold crossed reports its own conversion, once.",
        "configReference": "config_reference.json",
        "tests": [
            {
                "name": "One occurrence crosses the value 1 threshold only",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://a.example/" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "Two occurrences still do not cross the value 3 threshold",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://a.example/" },
                    { "type": "captchaDetected", "tabId": "tab-2", "url": "https://b.example/" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" }
                ]
            },
            {
                "name": "Three occurrences cross both thresholds, each reporting once",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://a.example/" },
                    { "type": "captchaDetected", "tabId": "tab-2", "url": "https://b.example/" },
                    { "type": "captchaDetected", "tabId": "tab-3", "url": "https://c.example/" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" },
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "3" }
                ]
            },
            {
                "name": "A fourth occurrence reports nothing further",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://a.example/" },
                    { "type": "captchaDetected", "tabId": "tab-2", "url": "https://b.example/" },
                    { "type": "captchaDetected", "tabId": "tab-3", "url": "https://c.example/" },
                    { "type": "captchaDetected", "tabId": "tab-4", "url": "https://d.example/" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" },
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "3" }
                ]
            },
            {
                "name": "Occurrences outside the window do not count towards a threshold",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 9 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://a.example/" },
                    { "type": "captchaDetected", "tabId": "tab-2", "url": "https://b.example/" },
                    { "type": "captchaDetected", "tabId": "tab-3", "url": "https://c.example/" }
                ],
                "expectConversions": []
            }
        ]
    },
    "eventStream": {
        "name": "Event stream semantics for metrics",
        "desc": "Metrics observe the raw event stream and apply no de-duplication of their own, matching immediate-trigger telemetry rather than aggregate counters. This only affects metrics with a value above 1. See alternatives_tests.json for the tab-scoped de-duplication alternative under discussion.",
        "configReference": "config_reference.json",
        "tests": [
            {
                "name": "Repeated occurrences within one page in one tab all count",
                "desc": "The decisive case. Aggregate counters would collapse these to one; metrics do not.",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/page" },
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/page" },
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/page" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" },
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "3" }
                ]
            },
            {
                "name": "Occurrences spread across navigations in one tab all count",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/one" },
                    { "type": "navigation", "tabId": "tab-1", "url": "https://example.com/two" },
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/two" },
                    { "type": "navigation", "tabId": "tab-1", "url": "https://example.com/three" },
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/three" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" },
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "3" }
                ]
            },
            {
                "name": "Occurrences across separate tabs all count",
                "exceptPlatforms": [],
                "activeExperiments": [
                    { "experiment": "contentScopeExperiment1", "cohort": "treatment", "enrollmentDate": "2026-01-10", "daysSinceEnrollment": 1 }
                ],
                "events": [
                    { "type": "captchaDetected", "tabId": "tab-1", "url": "https://example.com/" },
                    { "type": "captchaDetected", "tabId": "tab-2", "url": "https://example.com/" },
                    { "type": "captchaDetected", "tabId": "tab-3", "url": "https://example.com/" }
                ],
                "expectConversions": [
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "1" },
                    { "metric": "captchaSeen", "experiment": "contentScopeExperiment1", "cohort": "treatment", "conversionWindowDays": "0-7", "value": "3" }
                ]
            }
        ]
    }
}
