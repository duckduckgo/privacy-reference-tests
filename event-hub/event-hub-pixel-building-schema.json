{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "EventHub pixel building reference tests",
    "type": "object",
    "properties": {
        "$schema": { "type": "string" }
    },
    "patternProperties": {
        "^[a-zA-Z]+$": {
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "desc": { "type": "string" },
                "tests": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/definitions/test" }
                }
            },
            "required": ["name", "tests"],
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "definitions": {
        "test": {
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "config": { "type": "object" },
                "parameterState": { "type": "object" },
                "enrolledExperiments": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/enrolledExperiment" }
                },
                "periodStartUnixSeconds": { "type": "integer" },
                "expectFires": { "type": "boolean" },
                "expectParameters": { "type": "object" },
                "exceptPlatforms": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "ios-browser",
                            "android-browser",
                            "macos-browser",
                            "windows-browser",
                            "web-extension",
                            "safari-extension",
                            "web-extension-mv3"
                        ]
                    }
                }
            },
            "required": ["name", "config", "periodStartUnixSeconds", "expectFires"],
            "additionalProperties": false
        },
        "enrolledExperiment": {
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "cohort": { "type": "string" },
                "enrollmentUnixSeconds": { "type": "integer" }
            },
            "required": ["name", "cohort", "enrollmentUnixSeconds"],
            "additionalProperties": false
        }
    }
}
