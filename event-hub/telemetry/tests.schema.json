{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "EventHub telemetry reference tests",
    "type": "object",
    "properties": {
        "$schema": { "type": "string" }
    },
    "additionalProperties": { "$ref": "#/definitions/testSet" },
    "definitions": {
        "testSet": {
            "type": "object",
            "required": ["name", "desc", "configReference", "tests"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "desc": { "type": "string" },
                "configReference": { "type": "string" },
                "tests": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/definitions/test" }
                }
            }
        },
        "test": {
            "type": "object",
            "required": ["name", "exceptPlatforms", "events", "expectPixels"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "desc": { "type": "string" },
                "exceptPlatforms": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "events": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event" }
                },
                "expectPixels": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/pixel" }
                }
            }
        },
        "event": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
                "type": { "type": "string" },
                "tabId": { "type": "string" },
                "url": { "type": "string" },
                "data": { "type": "object" }
            }
        },
        "pixel": {
            "type": "object",
            "required": ["pixel", "params"],
            "additionalProperties": false,
            "properties": {
                "pixel": { "type": "string" },
                "params": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                }
            }
        }
    }
}
